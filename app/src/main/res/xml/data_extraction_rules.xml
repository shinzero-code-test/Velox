<?xml version="1.0" encoding="utf-8"?>
<!-- H1 (app-shell review): keep credential-bearing DataStore out of cloud backup
     and device-to-device migrations (Android 12+ mechanism). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore" />
    </device-transfer>
</data-extraction-rules>
