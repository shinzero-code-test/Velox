package com.exapps.velox.core.ui.theme

import androidx.compose.foundation.shape.RoundedCornerShape
import androidx.compose.ui.unit.dp

/**
 * Corner radius tokens — DESIGN_SYSTEM.md §4.2.
 *
 * | Token       | Value | Usage                        |
 * |-------------|-------|-------------------------------|
 * | radius-xs   | 6dp   | Small chips, tags             |
 * | radius-sm   | 10dp  | Buttons, inputs                |
 * | radius-md   | 16dp  | Cards, list items               |
 * | radius-lg   | 24dp  | Large cards, bottom sheets      |
 * | radius-xl   | 32dp  | Hero cards, Now Playing art      |
 * | radius-full | 999dp | Pills, FABs, circular art        |
 */
object VeloxShapes {
    val xs = RoundedCornerShape(6.dp)
    val sm = RoundedCornerShape(10.dp)
    val md = RoundedCornerShape(16.dp)
    val lg = RoundedCornerShape(24.dp)
    val xl = RoundedCornerShape(32.dp)
    val full = RoundedCornerShape(999.dp)

    /** Bottom sheets round only the top corners (SCREEN_PATTERNS.md §2). */
    val sheetTop = RoundedCornerShape(topStart = 24.dp, topEnd = 24.dp)
}
