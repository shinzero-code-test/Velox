package com.exapps.velox.core.ui.theme

import androidx.compose.ui.unit.Dp
import androidx.compose.ui.unit.dp

/**
 * Spacing scale — DESIGN_SYSTEM.md §4.1: `4, 8, 12, 16, 20, 24, 32, 40, 48, 64`.
 *
 * Compose components should reference these tokens instead of raw `.dp` literals
 * (SCREEN_PATTERNS.md checklist item: "Design tokens only — no hard-coded colors/spacing").
 */
object VeloxSpacing {
    val xxs: Dp = 4.dp
    val xs: Dp = 8.dp
    val sm: Dp = 12.dp
    val md: Dp = 16.dp
    val lg: Dp = 20.dp
    val xl: Dp = 24.dp
    val xxl: Dp = 32.dp
    val xxxl: Dp = 40.dp
    val huge: Dp = 48.dp
    val massive: Dp = 64.dp

    /** Stitch DESIGN.md's "container-margin" (20px) lines up exactly with [lg] — used for
     * the standard horizontal screen margin. */
    val screenHorizontalMargin: Dp = lg
}
